      "integration": "SolaX Power",
      "local_control": true,
      "requirements": [
        "supported SolaX model",
        "local network/API access"
      ],
      "note": "Home Assistant has a SolaX Power integration; exact model and local API availability must be checked.",
      "source": "https://www.home-assistant.io/integrations/solax/"
    },
    {
      "id": "saj_solar",
      "target": "haos",
      "match_any": [
        "saj"
      ],
      "product_any": [
        "inverter",
        "solar inverter"
      ],
      "status": "candidate",
      "integration": "SAJ Solar Inverter",
      "local_control": true,
      "requirements": [
        "supported local web interface/model",
        "local network access"
      ],
      "note": "Home Assistant has an SAJ integration, but not every inverter exposes the required local interface.",
      "source": "https://www.home-assistant.io/integrations/saj/"
    }
  ],
